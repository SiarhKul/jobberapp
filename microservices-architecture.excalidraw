    {
      "id": "flows",
      "type": "text",
      "x": 90,
      "y": 1170,
      "width": 1029.46142578125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "seed": 25,
      "version": 3,
      "versionNonce": 414078418,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792698529306,
      "link": null,
      "locked": false,
      "text": "Producer → Consumer event contracts\n\nAUTH → Notification, Users                         USERS → Gig\nGIG → Users                                        CHAT → Notification\nORDER → Users, Notification                         REVIEW → Users, Order\n\nNotification consumes: Auth, Order, Chat             Auth consumes: —\nUsers consumes: Auth, Gig, Review                    Gig consumes: Users\nChat consumes: —                                     Order consumes: Review\nReview consumes: —\n\nLegend: “Send” = producer · “Receive” = consumer · services do not call each other with HTTP for these flows.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Producer → Consumer event contracts\n\nAUTH → Notification, Users                         USERS → Gig\nGIG → Users                                        CHAT → Notification\nORDER → Users, Notification                         REVIEW → Users, Order\n\nNotification consumes: Auth, Order, Chat             Auth consumes: —\nUsers consumes: Auth, Gig, Review                    Gig consumes: Users\nChat consumes: —                                     Order consumes: Review\nReview consumes: —\n\nLegend: “Send” = producer · “Receive” = consumer · services do not call each other with HTTP for these flows.",
      "lineHeight": 1.25,
